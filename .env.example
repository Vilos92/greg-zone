# Key used to authorize the cloudflared docker container.
COPYPARTY_CLOUDFLARED_TOKEN=hunter2

# Key used to authorize the tailscale docker container.
TAILSCALE_AUTH_KEY=hunter3
TAILSCALE_EXIT_NODE_AUTH_KEY=hunterexitnode3

# Password to access transmission remotely.
TRANSMISSION_PASSWORD=hunter4

# Password to access Grafana dashboards.
GRAFANA_PASSWORD=hunter5

# Hermes Agent dashboard login (Tailscale-only UI at http://greg-zone:9010).
# Model keys (Gemini, etc.) are configured in the Hermes GUI and persist under
# GregZone Vault/hermes — do not put those here.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=hunterhermes
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=hunterhermespass
HERMES_DASHBOARD_BASIC_AUTH_SECRET=hunterhermessecret

# Agent key for playit.
PLAYIT_SECRET_KEY=hunterplayit6

# Webhook URL for Jordania Minecraft server.
DISCORD_JORDANIA_WEBHOOK_URL=hunterjordania7

# Webhook URL for copyparty.
DISCORD_COPYPARTY_WEBHOOK_URL=huntercopyparty8

# Webhook URL for plex.
DISCORD_PLEX_WEBHOOK_URL=hunterplex9

# Webhook URL for nginx.
DISCORD_NGINX_WEBHOOK_URL=hunternginx10

# Webhook URL for infra.
DISCORD_INFRA_WEBHOOK_URL=hunterinfra11

# Secret for creating a symmetric encrypted value for request security (e.g. health check header authentication).
ALERT_MONITOR_SECRET=hunteralertmonitor12

# Secret for being able to make requests to https://theipapi.com for location services.
IP_API_ACCESS_KEY=hunteripapi13

# Password to access the infra redis instance.
INFRA_REDIS_PASSWORD=hunterredis14

# Fine-grained PAT for scriptlancer compose self-hosted runners (github-runner-*).
# Repo: Vilos92/scriptlancer. Permission: Administration (Read and write).
GITHUB_RUNNER_ACCESS_TOKEN=hunterrunner15

# Woodpecker CI (woodpecker-server + woodpecker-agent).
# Client/secret come from a classic GitHub OAuth app (Settings -> Developer
# settings -> OAuth Apps — NOT a GitHub App) with authorization callback URL
# http://greg-zone:9011/authorize.
WOODPECKER_GITHUB_CLIENT=hunterwoodpeckerclient18
WOODPECKER_GITHUB_SECRET=hunterwoodpeckersecret18
# Shared secret authenticating agent<->server gRPC; generate with `openssl rand -hex 32`.
WOODPECKER_AGENT_SECRET=hunterwoodpeckeragent18
# Signs agent session tokens (also `openssl rand -hex 32`); keeps agents logged in across server restarts.
WOODPECKER_GRPC_SECRET=hunterwoodpeckergrpc18

# Sparkify Slack/Spotify bot (submodule at ./sparkify). Runs in Socket Mode, so it
# is outbound-only and exposes no ports.
# Slack credentials come from the Sparkify app at https://api.slack.com/apps
# (Basic Information -> signing secret, OAuth -> bot token, Basic Information ->
# app-level token with connections:write). Channels are Slack channel IDs, not names.
SLACK_SIGNING_SECRET=huntersigning16
SLACK_BOT_TOKEN=xoxb-hunterbot16
SLACK_APP_TOKEN=xapp-hunterapp16
SLACK_GENERAL_CHANNEL=C0HUNTERGENERAL
SLACK_WORDLE_CHANNEL=C0HUNTERWORDLE
# Spotify client credentials come from https://developer.spotify.com/dashboard.
# The refresh token is minted by the authorization code flow, not the dashboard:
# run `pnpm spotify-auth-server` in ./sparkify and open http://127.0.0.1:3000/login
# (that exact redirect URI must be registered on the app). Refresh tokens do not
# expire on their own, so this only needs redoing if it is revoked.
SPOTIFY_CLIENT_ID=hunterspotifyid17
SPOTIFY_CLIENT_SECRET=hunterspotifysecret17
SPOTIFY_REFRESH_TOKEN=hunterspotifyrefresh17
# Must match an existing playlist name exactly. Sparkify exits if it finds no match.
SPOTIFY_PLAYLIST_NAME=Sad Boyz - Hot Hunter Summer
